# ──────────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# NOTE: In this project the canonical .env lives at the REPOSITORY ROOT,
# not inside backend/. Docker Compose reads the root .env for ${VAR}
# substitution, which feeds both the postgres and backend services.
#
# This file is kept here as a reference for backend-specific variables
# when running the FastAPI app manually outside of Docker Compose:
#
#   cd backend
#   cp .env.example .env
#   uvicorn app.main:app --reload
#
# When running inside Docker Compose, use the ROOT .env instead:
#   cp .env.example .env   (from the repository root)
#
# NEVER commit any .env file — all are listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL credentials ────────────────────────────────────────────────────
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pms_db

# ── SQLAlchemy connection URL ─────────────────────────────────────────────────
# Use "localhost" when running the backend locally (outside Docker).
# Use "postgres" (service name) when running inside Docker Compose.
DATABASE_URL=postgresql://pms_user:changeme@localhost:5432/pms_db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key
