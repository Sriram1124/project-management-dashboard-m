# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Project environment variable template
#
# This file lives at the repository root alongside docker-compose.yml.
# Docker Compose reads the root .env for ${VAR} substitution in
# docker-compose.yml, making all variables available to every service.
#
# To get started:
#   cp .env.example .env
#
# NEVER commit .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL credentials ────────────────────────────────────────────────────
# Used by the postgres service AND passed through to the backend service.
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pms_db

# ── SQLAlchemy connection URL (backend) ───────────────────────────────────────
# When running inside Docker Compose the host is the service name "postgres".
# When running the backend locally (outside Docker) replace "postgres" with
# "localhost".
DATABASE_URL=postgresql://pms_user:changeme@postgres:5432/pms_db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# Placeholder for the future JWT signing key — NOT used in Phase 1.
SECRET_KEY=change-this-to-a-long-random-secret-key
